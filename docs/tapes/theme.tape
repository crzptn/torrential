# The Margin palette from crates/tui/src/theme.rs, shared by the tapes here.
Set Shell "bash"
Set FontFamily "Menlo"
Set CursorBlink false
Set WindowBar Rings
Set MarginFill "#837C70"
Set Theme {"name":"margin","background":"#14120F","foreground":"#F0E9DC","selection":"#3B3730","cursor":"#A6C79A","cursorAccent":"#14120F","black":"#3B3730","brightBlack":"#837C70","red":"#E2806E","brightRed":"#E2806E","green":"#A6C79A","brightGreen":"#A6C79A","yellow":"#BDB5A6","brightYellow":"#F0E9DC","blue":"#BDB5A6","brightBlue":"#F0E9DC","magenta":"#E2806E","brightMagenta":"#E2806E","cyan":"#A6C79A","brightCyan":"#A6C79A","white":"#BDB5A6","brightWhite":"#F0E9DC"}
